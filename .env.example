# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=
USE_POLLING=true
TELEGRAM_WEBHOOK_URL=
PORT=3000

# --- Postgres ---
DATABASE_URL=postgres://tgkb:tgkb@localhost:5432/tgkb

# --- Embeddings (MVP default: Voyage AI) ---
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=1024

# --- LLM ---
# LLM_PROVIDER=anthropic to call Claude directly (LLM_MODEL=claude-opus-4-8),
# or LLM_PROVIDER=openrouter to route any model (incl. Claude) through
# OpenRouter's billing instead — see src/llm/openrouterProvider.js.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5

# --- Query pipeline tuning ---
CONFIDENCE_THRESHOLD=0.35
CHUNK_MAX_TOKENS=200
CHUNK_MAX_GAP_MINUTES=20
FREE_TIER_DAILY_QUESTION_LIMIT=20
RELATED_MESSAGES_LIMIT=4
RELATED_MESSAGES_MIN_SCORE=0.15

# --- MTProto (backfill + twice-daily sync) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
MTPROTO_SESSION_STRING=
MTPROTO_SYNC_CRON="0 0,12 * * *"

NODE_ENV=development
LOG_LEVEL=info
